<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03090C">

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#03090C"
        android:translationZ="-1dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.2" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.74" />

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/nav_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="@drawable/oryn_bg_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guide_left">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/oryn_bg_nav_active"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Home"
            android:textColor="#EFFFFA"
            android:textSize="13sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/oryn_bg_nav_item"
            android:drawableStart="@drawable/ic_px_book"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="Instances"
            android:textAllCaps="false"
            android:textColor="#C9D8D8"
            android:textSize="13sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/oryn_bg_nav_item"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="@string/mcl_option_customcontrol"
            android:textAllCaps="false"
            android:textColor="#C9D8D8"
            android:textSize="13sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/oryn_bg_nav_item"
            android:drawableStart="@drawable/ic_social_media"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="@string/mcl_button_social_media"
            android:textAllCaps="false"
            android:textColor="#C9D8D8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Center column -->
    <LinearLayout
        android:id="@+id/hero_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/oryn_bg_card_hero"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/premium_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="ORYNLAUNCHER PLUS"
                android:textColor="#F4FFFC"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/oryn_bg_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="PREMIUM"
                android:textColor="#2EE6B6"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Minecraft Java Edition, refined for mobile. Choose your version and jump in."
            android:textColor="#9DB4B4"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/oryn_bg_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/_52sdp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_36sdp"
                app:drawableEndPadding="@dimen/_1sdp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_px_edit" />
        </LinearLayout>
    </LinearLayout>

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/_62sdp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/oryn_bg_play"
        android:fontFamily="sans-serif-black"
        android:text="@string/main_play"
        android:textAllCaps="true"
        android:textColor="#03231C"
        app:layout_constraintTop_toBottomOf="@id/hero_card"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right" />

    <!-- Quick actions -->
    <LinearLayout
        android:id="@+id/quick_actions_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/oryn_bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/guide_right"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/quick_actions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="QUICK ACTIONS"
            android:textColor="#D8EEEB"
            android:textSize="10sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/oryn_bg_action_item"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="@string/main_install_jar_file"
            android:textAllCaps="false"
            android:textColor="#E3F2F0"
            android:textSize="12sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/oryn_bg_action_item"
            android:drawableStart="@drawable/ic_px_folder"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="@string/mcl_button_open_directory"
            android:textAllCaps="false"
            android:textColor="#E3F2F0"
            android:textSize="12sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/oryn_bg_action_item"
            android:drawableStart="@drawable/ic_px_sharelog"
            android:drawablePadding="8dp"
            android:gravity="center_vertical|start"
            android:paddingStart="12dp"
            android:text="@string/main_share_logs"
            android:textAllCaps="false"
            android:textColor="#E3F2F0"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
